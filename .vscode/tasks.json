{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build NextLang (Linux)",
        "type": "shell",
        "command": "musl-gcc",
        "args": [
          "-static",
          "src/nextlang.c",
          "src/parser.c",
          "src/codegen.c",
          "src/version.c", // This took me an embarrassingly long time to figure out
          "src/utils/updater.c",
          "src/utils/package.c",
          "-o",
          "update/nextlang-linux.exe"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Build NextLang (Windows)",
        "type": "shell",
        "command": "x86_64-w64-mingw32-gcc",
        "args": [
          "-static",
          "src/nextlang.c",
          "src/parser.c",
          "src/codegen.c",
          "src/version.c", // This took me an embarrassingly long time to figure out
          "src/utils/updater.c",
          "src/utils/package.c",
          "-o",
          "update/nextlang-win.exe"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      }
    ]
  }
  