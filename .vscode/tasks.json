{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build NextLang",
        "type": "shell",
        "command": "gcc",
        "args": [
          "src/nextlang.c",
          "src/parser.c",
          "src/codegen.c",
          "src/memory.c",
          "src/version.c", // This took me an embarrassingly long time to figure out
          "src/utils/updater.c",
          "src/utils/package.c",
          "-o",
          "nextlang"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      }
    ]
  }
  